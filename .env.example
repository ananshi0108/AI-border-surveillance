# ==============================================================================
# IBVAP Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="IBVAP - Intelligent Border Video Analytics Platform"
API_V1_STR="/api/v1"
NODE_TYPE="BOP"
DEBUG=True

# Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local SQLite testing: sqlite:///./ibvap_edge.db
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/ibvap_db"

# Storage Directories (Relative or Absolute)
STORAGE_DIR="./storage"
SNAPSHOT_DIR="./storage/snapshots"
CLIP_DIR="./storage/clips"

# Allowed CORS origins for frontend web/mobile dashboard
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
